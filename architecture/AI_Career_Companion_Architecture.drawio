        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n\n    U[\&quot;Student / User\&quot;]\n    UI[\&quot;Frontend Interface&lt;br/&gt;React\&quot;]\n\n    API[\&quot;Backend API Layer&lt;br/&gt;FastAPI\&quot;]\n\n    subgraph CANDIDATE[\&quot;Candidate Management\&quot;]\n        PROFILE[\&quot;Student Profile Module\&quot;]\n        UPLOAD[\&quot;Resume Upload &amp; Storage\&quot;]\n        PARSER[\&quot;Resume Parsing Module\&quot;]\n        EXTRACT[\&quot;LLM-based Information Extraction\&quot;]\n        STRUCT[\&quot;Structured Candidate Profile\&quot;]\n    end\n\n    subgraph AI[\&quot;AI Agent Layer\&quot;]\n        COORD[\&quot;Career Assistant&lt;br/&gt;(Supervisor / Coordinator)\&quot;]\n        MATCH[\&quot;Job-Resume Matching Agent\&quot;]\n        GAP[\&quot;Skill Gap Agent\&quot;]\n        RESUME[\&quot;Resume Agent\&quot;]\n        COVER[\&quot;Cover Letter Agent\&quot;]\n        INTERVIEW[\&quot;Interview Agent\&quot;]\n    end\n\n    subgraph RAG[\&quot;RAG Pipeline\&quot;]\n        KB[\&quot;Job Posting Knowledge Base\&quot;]\n        CHUNK[\&quot;Document Processing &amp; Chunking\&quot;]\n        EMBED[\&quot;Embedding Model\&quot;]\n        VECTOR[\&quot;Vector Database\&quot;]\n        RETRIEVE[\&quot;Retriever\&quot;]\n    end\n\n    LLM[\&quot;Large Language Model (LLM)\&quot;]\n\n    subgraph DATA[\&quot;Data Storage Layer\&quot;]\n        DB[(\&quot;PostgreSQL Database\&quot;)]\n        FILES[(\&quot;Resume File Storage\&quot;)]\n    end\n\n    TRACK[\&quot;Application Tracking Module\&quot;]\n\n    U --&gt; UI\n    UI &lt;--&gt; API\n\n    API --&gt; PROFILE\n    API --&gt; UPLOAD\n    UPLOAD --&gt; FILES\n    UPLOAD --&gt; PARSER\n    PARSER --&gt; EXTRACT\n    EXTRACT --&gt; LLM\n    EXTRACT --&gt; STRUCT\n    STRUCT --&gt; DB\n    PROFILE &lt;--&gt; DB\n\n    API --&gt; COORD\n    COORD --&gt; MATCH\n    COORD --&gt; GAP\n    COORD --&gt; RESUME\n    COORD --&gt; COVER\n    COORD --&gt; INTERVIEW\n\